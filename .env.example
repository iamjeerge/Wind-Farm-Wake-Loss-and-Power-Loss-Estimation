# Environment variables for Wind Wake Loss Tool
# Copy this file to .env and modify as needed

# Database
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=windwake
POSTGRES_PASSWORD=windwake
POSTGRES_DB=windwake

# Application
DEBUG=false
ENVIRONMENT=production
AUTO_SEED=true

# API
CORS_ORIGINS=["http://localhost", "http://localhost:80", "http://localhost:3000"]
